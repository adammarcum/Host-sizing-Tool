				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
    
    tell application "Finder"
        -- Get the folder containing this App
        set myFolder to (container of (path to me)) as text
        set myPosixFolder to POSIX path of myFolder
    end tell
    
    -- The launcher handles Python, libraries, theme and start-up
    try
        do shell script "test -f " &amp; quoted form of (myPosixFolder &amp; "Run_on_mac.command")
    on error
        display dialog "Run_on_mac.command was not found next to this app. Keep the app in the same folder as the Host Sizer files." buttons {"OK"} default button "OK" with icon caution
        return input
    end try

    tell application "Terminal"
        activate
        -- Run the sizing app using the specific relative path
        do script "cd " &amp; quoted form of myPosixFolder &amp; " &amp;&amp; bash Run_on_mac.command"
    end tell
    
    return input
end run</string>
				</dict>
